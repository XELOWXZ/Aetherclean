{
  "name": "aetherclean",
  "version": "1.0.0",
  "description": "PC Optimization & System Cleaner Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.aetherclean.app",
    "productName": "AetherClean Pro",
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "C:/Users/Birdl/AppData/Local/Temp/aether_build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app-icon.ico"
    },
    "asar": true,
    "asarUnpack": [
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "systeminformation": "^5.33.23"
  }
}
